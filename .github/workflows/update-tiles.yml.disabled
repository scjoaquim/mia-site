# ⛔⛔ [06-Set-2026] NAO REACTIVAR SEM REVER — este workflow ficou VENENOSO.
#   Ele regravava data.json e reescrevia os numeros DENTRO do resultados.html.
#   Desde 22-Ago a pagina le de licencas.miats.trade, e a 06-Set os JSON
#   congelados sairam do repositorio (commit 0a7caf8c). Religa-lo hoje poria
#   numeros velhos por cima de uma pagina que ja nao os usa.
#   Revisao geral de 06-Set-2026.

name: Atualizar tiles de resultados (MQL5)

# Busca os números ao vivo do sinal MQL5 PRO, regrava data.json e comita
# sozinho — a página resultados.html lê esse arquivo.
# Regrava também os números ESCRITOS no resultados.html (o fallback que
# aparece sem JS / antes do fetch), pra ele não contradizer o data.json.
# Ver scripts/update-tiles.mjs para a extração/formatação.

on:
  schedule:
    # de hora em hora. Pra mudar a frequência, edite só esta linha
    # (formato cron padrão, em UTC).
    - cron: '0 * * * *'
  workflow_dispatch: {} # permite rodar manualmente pela aba Actions, pra testar

permissions:
  contents: write

concurrency:
  group: update-tiles
  cancel-in-progress: false

jobs:
  update-tiles:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configurar Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Buscar números e atualizar data.json
        run: node scripts/update-tiles.mjs

      - name: Commitar se houve mudança
        run: |
          if git diff --quiet -- data.json resultados.html; then
            echo "Sem mudanças em data.json/resultados.html — nada a commitar."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data.json resultados.html
          git commit -m "chore: atualizar tiles de resultados (auto)"
          git push
